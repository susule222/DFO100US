package main
import("fmt";"os";"encoding/hex";"encoding/binary";"strconv";"dfolan/internal/game/wire")
func main(){raw,e:=hex.DecodeString(os.Args[1]); if e!=nil{panic(e)};if len(raw)<13{panic("fixture")};id:=binary.LittleEndian.Uint16(raw[1:]);if id!=39&&id!=117{panic("not a room fixture")};keys:=make([]byte,wire.SessionKeyBytes);for i:=range keys{keys[i]=byte(i%127+1)};b,e:=wire.DecryptPayload(keys,id,raw[13:]);if e!=nil{panic(e)};off:=0;if id==117{off=2}; newID,e:=strconv.ParseUint(os.Args[2],10,16);if e!=nil||newID<4096||newID>8192{panic("bad test entity")};binary.LittleEndian.PutUint16(b[off:],uint16(newID));c,e:=wire.EncryptPayload(keys,id,b);if e!=nil{panic(e)};raw[7]=wire.Checksum(append(append([]byte{},raw[11:13]...),b...));fmt.Printf("%x",append(raw[:13],c...))}
